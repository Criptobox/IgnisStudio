<resources>
    <style name="Theme.IgnisStudio" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/fondo</item>
        <item name="android:statusBarColor">@color/fondo</item>
        <item name="android:navigationBarColor">@color/nav</item>
    </style>

    <!-- Bienvenida: fondo índigo de la app con la llama del logo -->
    <style name="Theme.IgnisStudio.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/fondo_splash</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.IgnisStudio</item>
    </style>
</resources>
